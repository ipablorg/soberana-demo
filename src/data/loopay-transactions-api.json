          "estado": "Disponible"
        },
        "USDT": {
          "nombre": "Tether",
          "blockchains": ["ethereum", "polygon", "arbitrum"],
          "estado": "Disponible"
        },
        "EURC": {
          "nombre": "Euro Coin",
          "blockchains": ["ethereum", "polygon", "base"],
