          },
          "obtener": {
            "method": "GET",
            "endpoint": "/transactions/{transactionId}",
            "descripcion": "Obtiene el estado de una transacción"
          },
          "listar": {
            "method": "GET",
            "endpoint": "/transactions",
            "descripcion": "Lista transacciones con filtros",
            "query_params": {
              "type": "ON_RAMP|OFF_RAMP|TRANSFER",
              "status": "AWAITING_FUNDS|PROCESSING|SUCCESS|FAILED",
              "customerId": "uuid",
              "fromDate": "ISO-8601",
              "toDate": "ISO-8601",
              "page": "number",
              "limit": "number (max 100)"
            }
          }
        },
        "off_ramp": {
          "crear": {
            "method": "POST",
            "endpoint": "/transactions/off-ramp",
            "descripcion": "Crea una nueva transacción off-ramp (Crypto → Fiat)",
            "body": {
              "customerId": {
                "tipo": "uuid",
                "requerido": true
              },
              "sourceCurrency": {
                "tipo": "string",
                "requerido": true,
                "valores": ["USDC", "USDT", "EURC"]
              },
              "sourceAmount": {
                "tipo": "string",
                "requerido": true,
                "descripcion": "Monto en stablecoin (ej: '1000.00')"
              },
              "sourceBlockchain": {
                "tipo": "string",
                "requerido": true,
                "valores": ["ethereum", "polygon", "base", "arbitrum", "solana"]
              },
              "targetCurrency": {
                "tipo": "string",
                "requerido": true,
                "valores": ["USD", "EUR", "MXN", "BRL"]
              },
              "payment": {
                "tipo": "object",
                "requerido": true,
                "descripcion": "Detalles de pago según el rail",
                "variantes": {
                  "ACH": {
                    "rail": "ACH",
                    "bankAccountId": "uuid (de external_accounts)"
                  },
                  "WIRE": {
                    "rail": "WIRE",
                    "bankAccountId": "uuid"
                  },
                  "SEPA": {
                    "rail": "SEPA",
                    "bankAccountId": "uuid"
                  },
                  "SPEI": {
                    "rail": "SPEI",
                    "bankAccountId": "uuid"
                  },
                  "PIX": {
                    "rail": "PIX",
                    "keyType": "cpf|cnpj|email|phone|random",
                    "keyValue": "string"
                  }
                }
              },
              "exchangeRateId": {
                "tipo": "uuid",
                "requerido": false
              },
              "partnerFeeId": {
                "tipo": "uuid",
                "requerido": false
              }
            },
            "ejemplos": {
