    "transaction_anatomy": {
      "descripcion": "Cada transacción retorna una estructura consistente con detalles específicos según el tipo",
      "estructura_base": {
        "id": {
          "tipo": "uuid",
          "descripcion": "Identificador único de la transacción"
        },
        "customerId": {
          "tipo": "uuid",
          "descripcion": "ID del customer que realiza la transacción"
        },
        "type": {
          "tipo": "enum",
          "valores": ["ON_RAMP", "OFF_RAMP", "TRANSFER"],
          "descripcion": "Tipo de transacción"
        },
        "request": {
          "tipo": "object",
          "descripcion": "Parámetros de entrada para esta transacción"
        },
        "state": {
          "status": {
            "tipo": "string",
            "descripcion": "Estado actual de la transacción"
          },
          "payment": {
            "tipo": "object",
            "descripcion": "Campos específicos del rail (ej: brCode para PIX)"
          },
          "receipt": {
            "tipo": "object",
            "descripcion": "Tasa, montos, fees (después del settlement), transactionHash"
          },
          "error": {
            "tipo": "object",
            "descripcion": "Objeto de error opcional"
          }
        },
        "createdAt": {
          "tipo": "ISO-8601",
          "descripcion": "Fecha de creación"
        },
        "updatedAt": {
          "tipo": "ISO-8601",
          "descripcion": "Fecha de última actualización"
        }
      },
      "ejemplo_respuesta": {
        "id": "123e4567-e89b-12d3-a456-426614174000",
        "customerId": "3c90c3cc-0d44-4b50-8888-8dd25736052a",
        "type": "ON_RAMP",
        "request": {
          "rail": "PIX",
          "sourceCurrency": "BRL",
          "sourceAmount": "10000.00",
          "targetCurrency": "USDC",
          "targetBlockchain": "polygon"
        },
        "state": {
          "status": "AWAITING_FUNDS",
          "payment": {
            "brCode": "00020126580014br.gov.bcb.pix...",
            "expiresAt": "2024-01-15T11:00:00Z"
          }
        },
        "createdAt": "2024-01-15T10:00:00Z",
        "updatedAt": "2024-01-15T10:00:00Z"
      }
    },
    
    "statuses": {
      "on_ramp": {
        "AWAITING_FUNDS": {
          "descripcion": "Esperando el depósito del cliente en el rail de pago seleccionado",
          "siguiente": ["TRANSFERRING_FIAT", "FAILED"],
          "accion_usuario": "Usuario debe realizar el depósito usando las instrucciones de pago"
        },
        "TRANSFERRING_FIAT": {
          "descripcion": "Depósito identificado; confirmando liquidación fiat",
          "siguiente": ["TRADING", "FAILED"],
          "accion_usuario": null
        },
        "TRADING": {
          "descripcion": "Fondos confirmados; convirtiendo moneda fiat origen a stablecoin destino",
          "siguiente": ["TRANSFERRING_STABLECOIN", "FAILED"],
          "accion_usuario": null
        },
        "TRANSFERRING_STABLECOIN": {
          "descripcion": "Enviando stablecoin a la wallet destino",
          "siguiente": ["SUCCESS", "FAILED"],
          "accion_usuario": null
        },
        "SUCCESS": {
          "descripcion": "Stablecoin entregado; disponible en state.receipt y state.blockchain",
          "siguiente": [],
          "accion_usuario": "Transacción completada"
        },
        "FAILED": {
          "descripcion": "Transacción fallida/expirada; ver state.error si está presente",
          "siguiente": ["REFUNDING"],
          "accion_usuario": "Revisar error y reintentar si es posible"
        },
        "REFUNDING": {
          "descripcion": "Transacción ha fallado y los fondos serán devueltos a la cuenta bancaria de origen",
          "siguiente": ["REFUNDED"],
          "accion_usuario": null
        },
        "REFUNDED": {
          "descripcion": "Fondos han sido devueltos exitosamente",
          "siguiente": [],
          "accion_usuario": "Transacción reembolsada"
        }
      },
      "off_ramp": {
        "TRANSFERRING_STABLECOIN": {
          "descripcion": "Extrayendo fondos del stablecoin origen",
          "siguiente": ["TRADING", "FAILED"],
          "accion_usuario": null
        },
        "TRADING": {
          "descripcion": "Fondos confirmados; convirtiendo stablecoin origen a moneda fiat destino",
          "siguiente": ["TRANSFERRING_FIAT", "FAILED"],
          "accion_usuario": null
        },
        "TRANSFERRING_FIAT": {
          "descripcion": "Pago fiat en progreso",
          "siguiente": ["SUCCESS", "FAILED"],
          "accion_usuario": null
        },
        "SUCCESS": {
          "descripcion": "Fiat liquidado en el rail de pago seleccionado; disponible en state.receipt",
          "siguiente": [],
          "accion_usuario": "Transacción completada"
        },
        "FAILED": {
          "descripcion": "Transacción fallida/expirada; ver state.error",
          "siguiente": ["REFUNDING"],
          "accion_usuario": "Revisar error y reintentar si es posible"
        },
        "REFUNDING": {
          "descripcion": "Transacción ha fallado y los fondos serán devueltos a la wallet",
          "siguiente": ["REFUNDED"],
          "accion_usuario": null
        },
        "REFUNDED": {
          "descripcion": "Fondos han sido devueltos exitosamente a la wallet",
          "siguiente": [],
          "accion_usuario": "Stablecoins devueltos"
        }
      },
      "transfer": {
        "PROCESSING": {
          "descripcion": "Envío/confirmación on-chain en progreso",
          "siguiente": ["SUCCESS", "FAILED"],
          "accion_usuario": null
        },
        "SUCCESS": {
          "descripcion": "Transferencia confirmada on-chain; transactionHash y blockExplorerUrl disponibles",
          "siguiente": [],
          "accion_usuario": "Transferencia completada"
        },
        "FAILED": {
          "descripcion": "Transferencia fallida (ej: fondos insuficientes, dirección inválida, error de red); ver state.error",
          "siguiente": [],
          "accion_usuario": "Revisar error y reintentar"
        }
      }
    },
    
    "endpoints": {
      "transactions": {
        "on_ramp": {
          "crear": {
            "method": "POST",
            "endpoint": "/transactions/on-ramp",
            "descripcion": "Crea una nueva transacción on-ramp (Fiat → Crypto)",
            "headers": {
              "Authorization": "Bearer <token>",
              "Content-Type": "application/json",
              "Idempotency-Key": "<unique-key>"
            },
            "body": {
              "customerId": {
                "tipo": "uuid",
                "requerido": true,
                "descripcion": "ID del customer"
              },
              "rail": {
                "tipo": "string",
                "requerido": true,
                "valores": ["ACH", "WIRE", "SEPA", "SEPA_INSTANT", "SPEI", "PIX"],
                "descripcion": "Rail de pago fiat"
              },
              "sourceCurrency": {
                "tipo": "string",
                "requerido": true,
                "valores": ["USD", "EUR", "MXN", "BRL"],
                "descripcion": "Moneda fiat de origen"
              },
              "sourceAmount": {
                "tipo": "string",
                "requerido": true,
                "descripcion": "Monto en moneda fiat (ej: '1000.00')"
              },
              "targetCurrency": {
                "tipo": "string",
                "requerido": true,
                "valores": ["USDC", "USDT", "EURC"],
                "descripcion": "Stablecoin destino"
              },
              "targetBlockchain": {
                "tipo": "string",
                "requerido": true,
                "valores": ["ethereum", "polygon", "base", "arbitrum", "solana", "optimism"],
                "descripcion": "Blockchain destino"
              },
              "targetAddress": {
                "tipo": "string",
                "requerido": false,
                "descripcion": "Dirección de wallet externa (si no se usa wallet interna)"
              },
              "exchangeRateId": {
                "tipo": "uuid",
                "requerido": false,
                "descripcion": "ID de tasa bloqueada (si se usa locked rate)"
              },
              "partnerFeeId": {
                "tipo": "uuid",
                "requerido": false,
                "descripcion": "ID de fee del partner"
              },
              "purpose": {
                "tipo": "string",
                "requerido": true,
                "valores": ["PERSONAL_ACCOUNT", "BUSINESS_PAYMENT", "INVESTMENT", "OTHER"],
                "descripcion": "Propósito de la transacción"
              }
            },
            "ejemplos": {
              "PIX_to_USDC_Polygon": {
                "request": {
                  "method": "POST",
                  "url": "https://prod.soberana.network/v1/transactions/on-ramp",
                  "headers": {
                    "Authorization": "Bearer <token>",
                    "Content-Type": "application/json",
                    "Idempotency-Key": "unique-key-123"
                  },
                  "body": {
                    "customerId": "3c90c3cc-0d44-4b50-8888-8dd25736052a",
                    "rail": "PIX",
