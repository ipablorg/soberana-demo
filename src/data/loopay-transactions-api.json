        "transfer": {
          "crear": {
            "method": "POST",
            "endpoint": "/transactions/transfer",
            "descripcion": "Crea una transferencia de stablecoin entre wallets",
            "body": {
              "currency": {
                "tipo": "string",
                "requerido": true,
                "valores": ["USDC", "USDT", "EURC"]
              },
              "blockchain": {
                "tipo": "string",
                "requerido": true,
                "valores": ["ethereum", "polygon", "base", "arbitrum", "solana"]
              },
              "from": {
                "tipo": "uuid",
                "requerido": true,
                "descripcion": "ID del customer origen (usa su wallet interna)"
              },
              "to": {
                "tipo": "string",
                "requerido": true,
                "descripcion": "ID de customer destino o dirección de wallet externa"
              },
              "amount": {
                "tipo": "string",
                "requerido": true,
                "descripcion": "Monto a transferir (ej: '1000.000000')"
              },
              "memo": {
                "tipo": "string",
                "requerido": false,
                "descripcion": "Nota o referencia opcional"
              }
            },
            "ejemplos": {
              "transfer_interno": {
                "descripcion": "Transferencia entre dos customers de Loopay",
                "request": {
                  "body": {
                    "currency": "USDC",
                    "blockchain": "polygon",
                    "from": "cust_123",
                    "to": "cust_456",
                    "amount": "500.000000",
                    "memo": "Pago por servicios"
                  }
                },
                "response": {
                  "id": "txn_transfer_789",
