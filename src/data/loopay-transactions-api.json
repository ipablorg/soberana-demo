                    "purpose": "PERSONAL_ACCOUNT"
                  }
                },
                "response": {
                  "id": "txn_onramp_123",
                  "customerId": "3c90c3cc-0d44-4b50-8888-8dd25736052a",
                  "type": "ON_RAMP",
                  "request": {
                    "rail": "PIX",
                    "sourceCurrency": "BRL",
                    "sourceAmount": "5000.00",
                    "targetCurrency": "USDC",
                    "targetBlockchain": "polygon"
                  },
                  "state": {
