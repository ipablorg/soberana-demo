{
  "name": "suite-loopay-front",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Suite Loopay - Scalable Frontend Architecture",
  "scripts": {
    "codegen:safe": "graphql-codegen --config codegen.ts && node scripts/patch-gql-runtime.mjs || echo Backend no disponible. Usando tipos GraphQL existentes.",
    "dev": "npm run codegen:safe && npm run i18n:compile && vite",
    "build": "npm run i18n:compile && vite build",
    "build:dev": "npm run i18n:compile && vite build --mode development",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile && node scripts/normalize-lingui-keys.mjs",
    "i18n:verify": "bash scripts/verify-i18n.sh",
    "zentinel:smoke": "node scripts/zentinel-smoke.mjs",
    "firebase:mfa-reset": "node scripts/reset-firebase-mfa.mjs",
    "firebase:verify-email": "node scripts/verify-firebase-email.mjs",
    "i18n": "npm run i18n:extract && npm run i18n:compile",
    "codegen": "graphql-codegen --config codegen.ts && node scripts/patch-gql-runtime.mjs",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch"
  },
